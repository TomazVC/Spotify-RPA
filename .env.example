# Crie 3 playlists próprias, sem conteúdo explícito, copie a URI de cada uma no Spotify.
# Exemplo de formato: spotify:playlist:37i9dQZF1DX...
PLAYLIST_1_URI=spotify:playlist:COLE_A_URI_1
